@page
@model Gameregistry.Pages.Videogames.DetailsModel

@{
    ViewData["Title"] = "Detalles";
}

<h1>@Model.Videogames.Name</h1>

<div class="detail-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Videogames.Description)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Videogames.Description)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Videogames.Publisher)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Videogames.Publisher)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Videogames.Genre)
        </dt>
        <dd class="col-sm-9">
            <span class="genre-badge">@Model.Videogames.Genre</span>
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Videogames.ReleaseYear)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Videogames.ReleaseYear)
        </dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    <a asp-page="./Edit" asp-route-id="@Model.Videogames.Id" class="btn btn-outline-primary">Editar</a>
    <a asp-page="./Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>
