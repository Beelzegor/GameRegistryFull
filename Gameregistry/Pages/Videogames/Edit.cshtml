@page
@model Gameregistry.Pages.Videogames.EditModel

@{
    ViewData["Title"] = "Editar videojuego";
}

<h1>Editar videojuego</h1>

<div class="form-card">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Videogames.Id" />
        <div class="form-group mb-3">
            <label asp-for="Videogames.Name" class="control-label"></label>
            <input asp-for="Videogames.Name" class="form-control" aria-required="true" />
            <span asp-validation-for="Videogames.Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Videogames.Description" class="control-label"></label>
            <input asp-for="Videogames.Description" class="form-control" aria-required="true" />
            <span asp-validation-for="Videogames.Description" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Videogames.Publisher" class="control-label"></label>
            <input asp-for="Videogames.Publisher" class="form-control" aria-required="true" />
            <span asp-validation-for="Videogames.Publisher" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Videogames.Genre" class="control-label"></label>
            <input asp-for="Videogames.Genre" class="form-control" aria-required="true" />
            <span asp-validation-for="Videogames.Genre" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Videogames.ReleaseYear" class="control-label"></label>
            <input asp-for="Videogames.ReleaseYear" class="form-control" aria-required="true" />
            <span asp-validation-for="Videogames.ReleaseYear" class="text-danger"></span>
        </div>
        <div class="form-group d-flex gap-2">
            <input type="submit" value="Guardar" class="btn btn-primary" />
            <a asp-page="./Index" class="btn btn-outline-secondary">Volver al listado</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
